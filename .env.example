# Required: Discord developer portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: register slash commands to one server only (instant updates while testing).
# Leave empty to register globally.
DISCORD_GUILD_ID=

# Hugging Face read token for the gated Phonon and NeuTTS model files. Accept the
# terms first at huggingface.co/gradium/phonon-40m-en,
# huggingface.co/neuphonic/neutts-air-q8-gguf and huggingface.co/neuphonic/neucodec-onnx-decoder.
HF_TOKEN=

# Optional tuning (defaults shown). Remove the leading "# " to change a value.
# TTS_MODELS=phonon,neutts,pocket,kokoro
# PHONON_MODEL=hf://gradium/phonon-40m-en
# PHONON_QUANT=q8
# PHONON_URL=http://phonon:8880
# PHONON_STARTUP_TIMEOUT_SECONDS=300
# NEUTTS_BACKBONE=neuphonic/neutts-air-q8-gguf
# NEUTTS_URL=http://neutts:8880
# NEUTTS_STARTUP_TIMEOUT_SECONDS=300
# DEFAULT_MODEL=phonon
# DEFAULT_VOICE=Harper
# TTS_THREADS=4
# TTS_SPEED=1.0
# MAX_TEXT_LENGTH=300
# MAX_QUEUE_LENGTH=10
# IDLE_TIMEOUT_MINUTES=15
# REPLY_DELETE_AFTER_PLAYBACK=true
# REPLY_DELETE_MINUTES=0
# LOG_LEVEL=info
